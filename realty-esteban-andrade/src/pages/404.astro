---
import Base from '@/layouts/Base.astro';
---
<Base title="Página no encontrada">
  <div class="container-app py-24 text-center">
    <p class="font-display text-6xl text-brand">404</p>
    <h1 class="mt-4 text-2xl">Esta página ya no existe</h1>
    <p class="mt-2 text-ink-2">Puede que la propiedad se haya retirado del mercado.</p>
    <a href="/propiedades" class="btn-primary mt-6">Ver propiedades disponibles</a>
  </div>
</Base>
